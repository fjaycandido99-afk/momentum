generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Priority Alerts enums
enum AlertPriority {
  urgent
  high
  normal
  low
}

enum AlertStatus {
  pending
  queued
  sent
  delivered
  failed
  cancelled
}

enum AlertChannel {
  push
  in_app
  email
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String? // from the auth provider — often a full legal name
  // What the person wants to be called, set by them (Settings → Account).
  // This is the name the coach and the journal use; `name` is only a
  // fallback, and its first word at that.
  preferred_name String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Preferences
  preferences  UserPreferences?
  sessions          Session[]
  favorites         FavoriteContent[]
  subscription      Subscription?
  goals             Goal[]
  playlists         Playlist[]
  pushSubscriptions PushSubscription[]
  xpEvents          XPEvent[]
  achievements      UserAchievement[]

  // Priority Alerts
  alertPreferences UserAlertPreference[]
  scheduledAlerts  ScheduledAlert[]
  alertHistory     AlertHistory[]

  // AI
  aiUsage          AiUsageDaily[]

  // Daily Read
  assessmentAnswers AssessmentAnswer[]

  // Self-reported wellness check-ins (consented, see UserPreferences)
  wellnessCheckIns WellnessCheckIn[]
  assessmentSignature AssessmentSignature?

  // Era
  eras Era[]

  // The practice step of a day — a guided exercise Voxu ran with them
  exerciseRuns ExerciseRun[]

  // Disciplines they already care about, kept consistent (lib/practices)
  practices Practice[]

  // Nervous-System mode: the times they came for regulation, not a push
  resetSessions ResetSession[]

  // What they are reading, and what they finished
  books Book[]

  // Their day, as they arranged it (lib/routines). One per person.
  routine Routine?
}

model Subscription {
  id      String @id @default(cuid())
  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Subscription status
  tier   String @default("free") // "free" | "premium"
  status String @default("active") // "active" | "trialing" | "canceled" | "expired"

  // Trial tracking
  trial_start DateTime?
  trial_end   DateTime?

  // Billing info
  billing_period_start DateTime?
  billing_period_end   DateTime?

  // Stripe (web)
  stripe_customer_id     String? @unique
  stripe_subscription_id String? @unique

  // RevenueCat (mobile)
  revenuecat_user_id String? @unique

  // Usage tracking (for free tier limits)
  sessions_today    Int       @default(0)
  last_session_date DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([tier])
  @@index([status])
}

model UserPreferences {
  id      String @id @default(cuid())
  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Schedule
  wake_time    String? // "06:30" format
  workout_time String? // "07:00" format

  // Audio style
  voice_style   String   @default("calm") // "calm" | "direct" | "energetic"
  content_focus String[] @default(["motivation", "mindfulness"]) // topics to include

  // Activity preferences
  activity_type String @default("workout") // "workout" | "morning" | "commute" | "evening"

  // Notifications
  daily_reminder Boolean @default(true)
  reminder_time  String? // "06:25" format

  // Era wake-up call (lib/era/wake.ts). Its own time, not wake_time: that
  // one is defaulted to 07:00 by several screens, and a call nobody chose
  // must never go out.
  wake_call_enabled Boolean @default(false)
  wake_call_time    String? // "06:30" format, user-local

  // Daily wellness check-in (lib/wellness). OFF until the user turns it on
  // from the consent card, and never inferred — nothing is written to
  // WellnessCheckIn while this is false. consented_at records when they
  // agreed, which is what makes the collection lawful.
  wellness_enabled     Boolean   @default(false)
  wellness_consented_at DateTime?

  // Appear in the circles of people whose era link you used, or who used
  // yours (lib/era/circle.ts). On by default, and the join page says what
  // they'll see — a first name, the era, the day, the streak. Off hides you
  // from every circle at once.
  circle_visible Boolean @default(true)

  // User Type
  user_type String @default("professional") // "professional" | "student" | "hybrid"

  // Daily Guide Schedule
  work_days             Int[]   @default([1, 2, 3, 4, 5]) // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  work_start_time       String? // "09:00" format
  work_end_time         String? // "17:00" format
  guide_tone            String  @default("calm") // "calm" | "direct" | "neutral"
  locked_tone           String? // Tone locked during onboarding for free users (can't change later)
  daily_guide_enabled   Boolean @default(false)
  guide_onboarding_done Boolean @default(false)
  theme_onboarding_done Boolean @default(false)

  // Student-specific settings
  class_days       Int[]   @default([1, 2, 3, 4, 5]) // Days with classes
  class_start_time String? // "08:00" format
  class_end_time   String? // "15:00" format
  study_start_time String? // Preferred study time start
  study_end_time   String? // Preferred study time end
  exam_mode        Boolean @default(false) // Enable during exam periods

  // Enhanced Daily Guide - Modules & Customization
  workout_enabled      Boolean @default(true)
  workout_intensity    String  @default("full") // "none" | "light" | "full"
  micro_lesson_enabled Boolean @default(true)
  default_time_mode    String  @default("normal") // "quick" | "normal" | "full"
  breath_cues_enabled  Boolean @default(true)

  // Segment customization
  enabled_segments String[] @default(["morning_prime", "midday_reset", "wind_down", "bedtime_story"])
  segment_order    String[] @default(["morning_prime", "midday_reset", "wind_down", "bedtime_story"])

  // Background music preferences
  background_music_enabled Boolean @default(true)
  preferred_music_genre    String? // Override daily rotation: "lofi" | "piano" | "jazz" | "classical" | "ambient" | "study"

  // Streak tracking (days used this week)
  current_streak   Int       @default(0)
  last_active_date DateTime?

  // Gamification
  total_xp Int @default(0)

  // Daily Guide reminders — one per segment.
  //
  // Morning already had daily_reminder + reminder_time. Bedtime was
  // DERIVED as wake_time minus 8h and could not be set directly, and
  // Midday/Wind Down were hardcoded to 13:00 and 19:00 in push-service.
  // All four are now on the same footing: an on/off and a time the user
  // picks. Times are HH:MM in the user's own timezone.
  //
  // Midday and Wind Down default ON to match the behaviour already
  // shipped (they rode checkpoint_alerts), so this only adds control.
  // bedtime_reminder_time is nullable and falls back to the old
  // wake_time-8h derivation when unset, so nobody's bedtime moves.
  midday_reminder_enabled   Boolean @default(true)
  midday_reminder_time      String? // 13:00
  winddown_reminder_enabled Boolean @default(true)
  winddown_reminder_time    String? // 19:00
  bedtime_reminder_time     String? // overrides the wake_time-8h default

  // Bedtime reminder
  bedtime_reminder_enabled Boolean @default(false)

  // DEAD. Astrology was deleted; these two columns are kept only because
  // dropping a column here means a `db push` against the single production
  // database, and there is nothing to gain. Nothing reads or writes them —
  // do not wire anything to them, and do not take their presence as a sign
  // the feature is coming back.
  astrology_enabled Boolean @default(false)
  zodiac_sign       String?

  // Timezone (IANA format e.g. "America/New_York")
  timezone String?

  // AI memory consent. OFF by default and never inferred — the chat only
  // reads journal entries and saved quotes once the user has explicitly
  // turned this on. Applies to every tier: a paying user is equally
  // entitled to a companion that has NOT read their diary.
  ai_memory_enabled     Boolean   @default(false)
  ai_memory_consented_at DateTime?

  // Mindset system
  mindset             String    @default("stoic")
  mindset_selected_at DateTime?

  // F7: Wellness Score
  wellness_score_7day_avg Int?
  last_wellness_alert     DateTime?

  // F9: Mindset Evolution
  mindset_suggestion_shown_at DateTime?

  // Streak freeze (engagement)
  streak_freezes             Int       @default(1)
  streak_freeze_used_at      DateTime?
  streak_freeze_weekly_reset DateTime?
  last_streak_value          Int       @default(0)
  streak_lost_at             DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Session {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Session details
  activity_type    String // "workout" | "morning" | "commute" | "evening"
  duration_planned Int // minutes planned
  duration_actual  Int? // actual minutes completed

  // Timestamps
  started_at   DateTime  @default(now())
  completed_at DateTime?

  // User feedback (optional)
  rating      Int? // 1-5 stars
  mood_before String? // "low" | "medium" | "high"
  mood_after  String?

  @@index([user_id])
  @@index([started_at])
}

model FavoriteContent {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  content_type  String // "quote" | "lesson" | "breathing" | "soundscape" | "music" | "motivation"
  content_text  String
  content_id    String?
  content_genre String?
  content_title String?
  thumbnail     String?

  created_at DateTime @default(now())

  @@index([user_id])
}

model DailyGuide {
  id      String   @id @default(cuid())
  user_id String
  date    DateTime @db.Date

  // Day classification - supports both professional and student
  day_type String // "work" | "off" | "recovery" | "class" | "study" | "exam"
  pace     String @default("focused") // "focused" | "open" | "gentle"

  // User inputs for this day
  time_mode    String  @default("normal") // "quick" | "normal" | "full"
  energy_level String? // "low" | "normal" | "high" (morning input)

  // Selected modules for this day
  modules String[] @default([]) // ["morning_prime", "midday_reset", "wind_down", "bedtime_story"]

  // === V2 Session Scripts (4 time-based sessions) ===
  midday_reset_script  String? // ~2 min recharge + affirmation
  wind_down_script     String? // ~2 min evening reflection + grounding
  bedtime_story_script String? // ~6-8 min motivational sleep story

  // V2 Session completion tracking
  midday_reset_done  Boolean @default(false)
  wind_down_done     Boolean @default(false)
  bedtime_story_done Boolean @default(false)

  // === Legacy V1 scripts (kept for backward compat) ===
  morning_prime_script String? // 30-90s intention setting
  movement_script      String? // 60-90s energizing movement guidance
  micro_lesson_script  String? // 60-120s quick insight/tip
  breath_script        String? // 60-90s breathing exercise

  // Evening
  day_close_script String? // 30-60s evening reflection
  tomorrow_preview String? // Preview message for tomorrow

  // Student-specific scripts
  pre_study_script   String? // Focus prep before studying
  study_break_script String? // Reset between study sessions
  exam_calm_script   String? // Anxiety relief before exams

  // Legacy fields for backward compatibility
  workout_script      String?
  morning_script      String?
  midday_script       String?
  afternoon_script    String?
  evening_script      String?
  micro_lesson        String?
  checkpoint_1_script String?
  checkpoint_2_script String?
  checkpoint_3_script String?

  // Segment completion tracking
  morning_prime_done Boolean @default(false)
  movement_done      Boolean @default(false)
  micro_lesson_done  Boolean @default(false)
  breath_done        Boolean @default(false)
  day_close_done     Boolean @default(false)

  // Legacy tracking
  morning_played    Boolean @default(false)
  evening_played    Boolean @default(false)
  workout_completed Boolean @default(false)
  checkpoint_1_done Boolean @default(false)
  checkpoint_2_done Boolean @default(false)
  checkpoint_3_done Boolean @default(false)

  // Background music used
  music_genre_used String? // Which genre was played

  // Daily AI Voice Guides (generated once per day, max 2 min each)
  breathing_script   String? // Breathing exercise script
  breathing_audio    String? // Base64 audio from ElevenLabs
  breathing_duration Int? // Duration in seconds

  affirmation_script   String? // Daily affirmations script
  affirmation_audio    String? // Base64 audio
  affirmation_duration Int?

  gratitude_script   String? // Gratitude practice script
  gratitude_audio    String? // Base64 audio
  gratitude_duration Int?

  sleep_script   String? // Sleep/wind down script
  sleep_audio    String? // Base64 audio
  sleep_duration Int?

  grounding_script   String? // Anxiety grounding script
  grounding_audio    String? // Base64 audio
  grounding_duration Int?

  stress_relief_script      String?
  stress_relief_audio       String?
  stress_relief_duration    Int?

  focus_meditation_script   String?
  focus_meditation_audio    String?
  focus_meditation_duration Int?

  self_compassion_script    String?
  self_compassion_audio     String?
  self_compassion_duration  Int?

  confidence_script         String?
  confidence_audio          String?
  confidence_duration       Int?

  bedtime_story_audio       String?
  bedtime_story_duration    Int?

  midday_reset_audio        String?
  midday_reset_duration     Int?

  wind_down_audio           String?
  wind_down_duration        Int?

  // Day-type specific Morning Prime voices (generated for all types daily)
  work_prime_script   String? // Work day morning intention
  work_prime_audio    String? // Base64 audio
  work_prime_duration Int?

  off_prime_script   String? // Off day morning intention
  off_prime_audio    String? // Base64 audio
  off_prime_duration Int?

  recovery_prime_script   String? // Recovery day morning intention
  recovery_prime_audio    String? // Base64 audio
  recovery_prime_duration Int?

  // Day-type specific Day Close voices
  work_close_script   String? // Work day evening reflection
  work_close_audio    String? // Base64 audio
  work_close_duration Int?

  off_close_script   String? // Off day evening reflection
  off_close_audio    String? // Base64 audio
  off_close_duration Int?

  recovery_close_script   String? // Recovery day evening reflection
  recovery_close_audio    String? // Base64 audio
  recovery_close_duration Int?

  // Journal entries
  journal_win       String? // "What was your win today?"
  journal_gratitude String? // "What are you grateful for?"
  journal_learned   String? // "What did you learn?"
  journal_intention String? // Weekly intention (set on Sundays)
  journal_freetext  String? // Free-form text from "Free Write" mode
  journal_mood      String? // 5-level: "awful" | "low" | "okay" | "good" | "great"
  journal_prompt    String? // Which rotating prompt was shown

  // === Morning Minute — the 60-second daily voice ritual that is the
  //     primary entry point on home. One per day per user. Drives the
  //     spiral stroke + serves as the "you showed up today" signal. ===
  morning_minute_voice_url        String?   // Supabase Storage URL of the raw audio
  morning_minute_voice_duration   Int?      // seconds
  morning_minute_transcript       String?   // Whisper transcript of the voice clip
  morning_minute_response         String?   // Single AI sentence offered back
  morning_minute_at               DateTime? // when the user completed the ritual

  // Mood tracking
  mood_before String? // "low" | "medium" | "high" - before morning flow
  mood_after  String? // "low" | "medium" | "high" - after day close

  // AI features
  journal_ai_reflection String? // AI-generated insight after journal save
  ai_affirmation        String? // Daily AI-generated affirmation
  ai_session_plan       String? // Cached smart session for the day
  ai_journal_themes     String? // Cached journal theme analysis
  ai_sound_mix          String? // Cached sound mix recommendation
  accountability_streak Int     @default(0) // Days of accountability check-ins
  accountability_last_checkin DateTime? // Last check-in timestamp
  ai_weekly_insights    String? // Cached weekly insights JSON
  ai_weekly_focus       String? // Next week focus suggestion

  // Astrology features
  cosmic_insight_script String?
  cosmic_insight_done   Boolean @default(false)

  // Path insight (non-Scholar mindsets)
  path_insight_script String?

  // Path journey tracking
  path_reflection_done   Boolean @default(false)
  path_exercise_done     Boolean @default(false)
  path_quote_viewed      Boolean @default(false)
  path_soundscape_played Boolean @default(false)
  path_streak            Int     @default(0)

  // Virtue tracking
  virtue_focus     String?
  virtue_rating    Int?

  // === New AI Features ===

  // F2: Morning Briefing
  ai_morning_briefing_script String?
  ai_morning_briefing_audio  String?

  // F3: Letter to Self (JSON)
  ai_letter_to_self String?

  // F4: Monthly Retrospective (JSON)
  ai_monthly_retrospective String?

  // F5: Conversational Journal (JSON)
  journal_conversation String?

  // F6: Dream Journal
  journal_dream              String?
  journal_dream_interpretation String? // JSON

  // F7: Wellness Score
  ai_wellness_score   Int?
  ai_wellness_factors String? // JSON

  // F9: Mindset Evolution (JSON)
  ai_mindset_suggestion String?

  // F10: Auto-DJ (JSON)
  ai_auto_dj_session String?

  // F11: Journal Tags
  journal_tags String[] @default([])

  // F13: Streak Recovery
  ai_streak_recovery_message String?

  // Engagement features
  daily_intention     String?
  daily_bonus_claimed Boolean @default(false)
  daily_bonus_amount  Int?

  created_at DateTime @default(now())

  @@unique([user_id, date])
  @@index([user_id])
  @@index([date])
}

// Push Notification Subscriptions
model PushSubscription {
  id       String @id @default(cuid())
  user_id  String
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String @default("") // Public key for encryption (web push)
  auth     String @default("") // Auth secret (web push)

  // Native app support
  platform     String  @default("web") // "web" | "ios" | "android"
  native_token String? // APNs token (iOS) or FCM token (Android)

  // Notification preferences
  morning_reminder          Boolean @default(true)
  checkpoint_alerts         Boolean @default(true)
  evening_reminder          Boolean @default(true)
  streak_alerts             Boolean @default(true)
  weekly_review             Boolean @default(true)
  insight_alerts            Boolean @default(true)
  daily_quote_alerts        Boolean @default(true)
  daily_affirmation_alerts  Boolean @default(true)
  motivational_nudge_alerts Boolean @default(true)
  daily_motivation_alerts       Boolean @default(true)
  featured_music_alerts         Boolean @default(true)
  coach_checkin_alerts          Boolean @default(true)
  coach_accountability_alerts   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([platform])
}

// Per-send log powering the notification send-gate (daily cap + dedupe).
// Relation-less + written fire-and-forget; the gate reads it to throttle so
// a user never gets bombarded across the 12 notification types.
model NotificationSendLog {
  id      String   @id @default(cuid())
  user_id String
  type    String
  sent_at DateTime @default(now())

  @@index([user_id, sent_at])
}

model Goal {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  title         String
  description   String?
  frequency     String   @default("daily") // "daily" | "weekly" | "monthly"
  target_count  Int      @default(1)
  current_count Int      @default(0)
  period_start  DateTime @default(now())
  status        String   @default("active") // "active" | "completed" | "archived"

  // F8: AI Goal Decomposition
  ai_micro_actions          String? // JSON
  ai_decomposition_generated DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([status])
}

// Shared audio cache for pre-written voice scripts (persists across Vercel cold starts)
// Keyed by type+scriptIndex+tone, reused across all users forever
model AudioCache {
  id         String   @id @default(cuid())
  cache_key  String   @unique // "breathing-s0-calm", "work_prime-s1-direct"
  audio      String // Base64 audio data
  duration   Int // Duration in seconds
  created_at DateTime @default(now())

  @@index([cache_key])
}

// Monthly ElevenLabs credit usage tracker
// One row per month, tracks total characters sent to TTS API
model TtsUsage {
  id         String   @id @default(cuid())
  month_key  String   @unique // "2026-02"
  credits    Int      @default(0) // Characters used
  updated_at DateTime @updatedAt

  @@index([month_key])
}

// Per-call Groq telemetry. Relation-less + written fire-and-forget so it
// can never block or break a request. The point: surface when AI silently
// degraded (outcome=failed → caller used canned content) or fell back to
// the cheap model (fell_back=true), plus per-endpoint token/latency.
model AiCallLog {
  id                String   @id @default(cuid())
  endpoint          String // which feature/route made the call (e.g. "journal-insights")
  requested_model   String // model originally asked for
  model             String // model that actually served (or last tried on failure)
  fell_back         Boolean  @default(false) // served by the fallback model, not the requested one
  outcome           String // "ok" | "failed"
  prompt_tokens     Int      @default(0)
  completion_tokens Int      @default(0)
  latency_ms        Int      @default(0)
  user_id           String? // optional; no FK on purpose
  error             String? // truncated error message on failure
  created_at        DateTime @default(now())

  @@index([created_at])
  @@index([endpoint, created_at])
  @@index([outcome, created_at])
}

// Cache for YouTube video search results (persists across Vercel cold starts)
model VideoCache {
  id        String   @id @default(cuid())
  cache_key String   @unique // "motivation-confidence" or "music-lofi"
  videos    Json // Array of video objects
  cached_at DateTime @default(now())

  @@index([cache_key])
}

model Playlist {
  id          String         @id @default(cuid())
  user_id     String
  user        User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name        String
  description String?
  items       PlaylistItem[]
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  @@index([user_id])
}

model PlaylistItem {
  id           String   @id @default(cuid())
  playlist_id  String
  playlist     Playlist @relation(fields: [playlist_id], references: [id], onDelete: Cascade)
  content_type String // "soundscape" | "music" | "motivation"
  content_id   String // soundscape id or youtubeId
  title        String
  subtitle     String?
  genre_id     String?
  thumbnail    String?
  position     Int      @default(0)
  created_at   DateTime @default(now())

  @@unique([playlist_id, content_type, content_id])
  @@index([playlist_id])
}

model XPEvent {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event_type String
  xp_amount  Int
  source     String?
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([user_id, created_at])
}

model FeatureEvent {
  id         String   @id @default(cuid())
  user_id    String
  feature    String
  action     String
  metadata   String?
  created_at DateTime @default(now())

  @@index([feature, created_at])
  @@index([created_at])
  @@index([user_id, created_at])
}

model UserAchievement {
  id             String   @id @default(cuid())
  user_id        String
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement_id String
  unlocked_at    DateTime @default(now())

  @@unique([user_id, achievement_id])
  @@index([user_id])
}

// ═══════════════ Priority Alerts System ═══════════════

// Defines available alert categories & default settings
model AlertType {
  id               String        @id // e.g. "morning_reminder", "streak_at_risk"
  label            String
  description      String?
  category         String        @default("general") // "reminder" | "coach" | "insight" | "streak" | "general"
  default_priority AlertPriority @default(normal)
  default_channel  AlertChannel  @default(push)
  cooldown_minutes Int           @default(0)
  premium_only     Boolean       @default(false)
  enabled          Boolean       @default(true)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  // Relations
  userPreferences UserAlertPreference[]
  scheduledAlerts ScheduledAlert[]
  alertHistory    AlertHistory[]

  @@map("alert_types")
}

// Per-user overrides for each alert type
model UserAlertPreference {
  id            String         @id @default(cuid())
  user_id       String
  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  alert_type_id String
  alert_type    AlertType      @relation(fields: [alert_type_id], references: [id], onDelete: Cascade)
  enabled       Boolean        @default(true)
  priority      AlertPriority? // NULL = use alert_type default
  channel       AlertChannel?  // NULL = use alert_type default
  quiet_start   String?        // Time string "22:00" — do not disturb start
  quiet_end     String?        // Time string "07:00" — do not disturb end
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  @@unique([user_id, alert_type_id])
  @@index([user_id])
  @@index([alert_type_id])
  @@map("user_alert_preferences")
}

// Queue for time-based and recurring alerts
model ScheduledAlert {
  id            String        @id @default(cuid())
  user_id       String
  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  alert_type_id String
  alert_type    AlertType     @relation(fields: [alert_type_id], references: [id], onDelete: Cascade)
  priority      AlertPriority @default(normal)
  channel       AlertChannel  @default(push)
  status        AlertStatus   @default(pending)

  // Scheduling
  scheduled_at    DateTime  // When to send
  expires_at      DateTime? // Auto-cancel if not sent by this time
  recurrence      String?   // NULL = one-time, "daily", "weekly", "custom"
  recurrence_rule String?   // Cron expression for custom recurrence
  next_run_at     DateTime? // Next occurrence for recurring alerts

  // Content
  title String
  body  String
  data  Json   @default("{}") // Custom payload (deep links, metadata)

  // Processing
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  last_error   String?
  processed_at DateTime? // When actually processed/sent

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  alertHistory AlertHistory[]

  @@index([user_id])
  @@index([status])
  @@index([scheduled_at])
  @@index([next_run_at])
  @@index([priority, scheduled_at])
  @@map("scheduled_alerts")
}

// Log of all sent alerts with delivery tracking
model AlertHistory {
  id                 String        @id @default(cuid())
  user_id            String
  user               User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  alert_type_id      String
  alert_type         AlertType     @relation(fields: [alert_type_id], references: [id], onDelete: SetNull)
  scheduled_alert_id String?
  scheduled_alert    ScheduledAlert? @relation(fields: [scheduled_alert_id], references: [id], onDelete: SetNull)
  priority           AlertPriority
  channel            AlertChannel
  status             AlertStatus   @default(sent)

  // Content snapshot
  title String
  body  String
  data  Json   @default("{}")

  // Delivery tracking
  sent_at      DateTime  @default(now())
  delivered_at DateTime?
  read_at      DateTime?
  clicked_at   DateTime?
  dismissed_at DateTime?

  // Error tracking
  error_message String?
  error_code    String?

  // Device info
  platform        String? // "web" | "ios" | "android"
  subscription_id String? // Reference to PushSubscription

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([alert_type_id])
  @@index([sent_at(sort: Desc)])
  @@index([user_id, status])
  @@index([scheduled_alert_id])
  @@map("alert_history")
}

// Per-day, per-feature AI usage counter backing the free tier's metered
// taste of each AI feature.
//
// This exists because lib/rate-limit.ts CANNOT do this job: it is an
// in-memory Map, per serverless instance, so a daily quota enforced
// there would reset on every cold start and differ per instance. A
// quota users can see and a paywall can cite has to be durable.
//
// `day` is a YYYY-MM-DD key in the USER'S timezone, not UTC — a cap
// that resets at 2pm local because the server rolled over at midnight
// UTC reads as a bug. Computed by dayKeyFor() in lib/ai/quota.ts.
model AiUsageDaily {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  feature String // AiFeatureKey — see lib/subscription-constants.ts
  day     String // "YYYY-MM-DD" in the user's local timezone
  count   Int    @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, feature, day])
  @@index([user_id, day])
}


// Alert state, so a live incident pages you once rather than every hour,
// and so recovery is announced exactly once too.
//
// Exists because AI telemetry alone was not enough: AiCallLog recorded the
// entire seventeen-day outage faithfully and nobody read it. Data without
// attention is not monitoring.
model SystemAlert {
  id     String @id @default(cuid())
  kind   String // e.g. ai_failure
  state  String // firing | resolved
  detail String?

  created_at DateTime @default(now())

  @@index([kind, created_at])
}

// One answered Daily Read item. See lib/assessment/axes.ts for the model.
//
// Deliberately NOT unique on (user_id, item_id): items come back around after
// RE_ASK_AFTER_DAYS because drift is the point — a lean that can move is what
// the history view exists to show, and a unique constraint would have made
// that unmeasurable.
//
// `axis` and `direction` are denormalised from the item bank so scoring is
// arithmetic over rows: computing a lean never has to load the bank, and
// rewording an item later cannot silently rewrite past answers.
model AssessmentAnswer {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  item_id   String // stable id from lib/assessment/items.ts
  axis      String // "agency" | "discipline" | "inquiry" | "faith"
  direction Int    // -1 or +1, the item's loading
  score     Int    // 1..5 as tapped
  local_day String // YYYY-MM-DD in the USER's timezone, not the server's

  created_at DateTime @default(now())

  @@index([user_id, created_at])
  @@index([user_id, item_id])
  @@index([user_id, local_day])
}

// The name the Daily Read currently gives this user, kept as a row so the
// "how many people land here" share is one grouped count over <=24 buckets
// rather than a scan of every answer ever written. Derived data: only ever
// recomputed from AssessmentAnswer, never edited, and losing it costs a
// recompute and nothing else.
//
// Someone sitting near the centre has no signature and simply has no row —
// they are not a cohort, and counting them as one would flatter the share.
model AssessmentSignature {
  user_id String @id
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  signature String // key from lib/assessment/signature.ts
  answered  Int    // answers behind it, so thin rows can be excluded later

  updated_at DateTime @updatedAt

  @@index([signature])
}

// An Era: a named stretch (30 days by default) the user commits to — "Locked
// In", "Gym Arc", or their own. The unit people say out loud: "Day 14 of my
// Locked In era". At most one is active per user; that is enforced in
// lib/era/service.ts rather than by a partial unique index Prisma can't model.
//
// `change` and `why` are what they told us on day 1. They are the whole point
// of the coach's replies later ("fourteen days ago you said…"), so they are
// stored verbatim and never rewritten.
//
// Days are the USER's calendar days (YYYY-MM-DD in their timezone), never the
// server's, same as AssessmentAnswer.local_day.
model Era {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  era_key     String // preset key from lib/era/presets.ts, or "custom"
  title       String // shown name; the preset's, or the user's own
  change      String // "What are you trying to change?"
  why         String? // "Why does it matter?" — optional
  length_days Int     @default(30)
  start_day   String // YYYY-MM-DD, user's timezone
  status      String  @default("active") // "active" | "ended"

  // The Era Recap: a letter from the coach about the finished 30 days
  // (premium). Written once when first asked for, then kept, so it reads
  // the same every time and costs one model call per era.
  recap    String?
  recap_at DateTime?

  // When we told them they'd finished (lib/era/nudges). Stamped on the ERA,
  // not inferred from the notification log: the send gate only dedupes for
  // 18 hours, so a finished era would be announced again every morning, and
  // a second era later must still be able to say it.
  completed_notified_at DateTime?

  ended_at   DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  promises EraPromise[]
  missions EraMission[]

  @@index([user_id, status])
  @@index([era_key, status])
}

// A shareable marketing link: voxu.app/i/<code>.
//
// NOT the same thing as EraReferral, which credits a friend for the era you
// joined from their card. This is the affiliate/partner channel: a code
// Francis hands out, with clicks and signups counted against it so a bonus
// can be paid on something verifiable.
model ReferralCode {
  id   String @id @default(cuid())
  code String @unique // what appears in the URL, e.g. "gymtok"

  // Who or what it was given to — "TikTok bio", a creator's name. Free text
  // because this is Francis's own bookkeeping, not user input.
  label String

  // Off without deleting: the link stops attributing, and the numbers it
  // already earned stay intact.
  active Boolean @default(true)

  hits ReferralHit[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([active])
}

// One event on a referral link: the click, and the signup it led to.
//
// A signup row carries the user, with one per user per code, so refreshing
// or reinstalling can never inflate a payout. Clicks are anonymous by
// nature — nobody is signed in yet.
model ReferralHit {
  id      String       @id @default(cuid())
  code_id String
  code    ReferralCode @relation(fields: [code_id], references: [id], onDelete: Cascade)

  kind    String // "click" | "signup"
  user_id String? // signups only

  created_at DateTime @default(now())

  @@unique([code_id, kind, user_id])
  @@index([code_id, kind])
  @@index([created_at])
}

// One day's self-reported state (lib/wellness/scales.ts).
//
// Four numbers the user taps — how they feel, energy, stress, how rested —
// plus optional context tags from a fixed list. Self-reported wellness, NOT
// a medical or clinical record: nothing here screens for, detects or treats
// anything, and no score is derived that pretends to.
//
// Written only while UserPreferences.wellness_enabled is true. Every field is
// optional: a day with only "slept badly" answered is still worth keeping.
model WellnessCheckIn {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  local_day String // YYYY-MM-DD in the user's timezone

  mood   Int? // 1–5, awful → great
  energy Int? // 1–5, drained → full
  stress Int? // 1–5, calm → overwhelmed
  rested Int? // 1–5, how rested they FEEL (perception, not sleep tracking)

  // What was going on, from a closed list — countable without free text.
  tags String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, local_day])
}

// A day's mission, marked done (lib/era/missions.ts).
//
// Its own row rather than a column on EraPromise, because a mission exists
// for every day of an era whether or not a promise was made that day — and
// "did the mission, never wrote a promise" is a real day that a column on
// the promise could not record.
//
// `day` is kept so the mission TEXT can be recovered from the era's bank
// without storing a copy of it: which missions people actually do is the
// question this answers.
model EraMission {
  id      String @id @default(cuid())
  era_id  String
  era     Era    @relation(fields: [era_id], references: [id], onDelete: Cascade)
  user_id String

  local_day String // YYYY-MM-DD, user's timezone
  day       Int // 1-based day of the era; index into the mission bank

  completed_at DateTime @default(now())

  @@unique([era_id, local_day])
  @@index([user_id, local_day])
}

// One promise per era per day. `kept` is null until they answer the check-in,
// and an unanswered day is left out of the kept % rather than counted as a
// miss — silence is not a broken promise.
model EraPromise {
  id      String @id @default(cuid())
  era_id  String
  era     Era    @relation(fields: [era_id], references: [id], onDelete: Cascade)
  user_id String

  local_day   String // YYYY-MM-DD, user's timezone
  text        String
  source      String    @default("typed") // "typed" | "spoken"
  coach_reply String?
  kept        Boolean?
  checked_at  DateTime?

  // One tap each, all optional (lib/era/reasons.ts). They turn a record of
  // WHAT happened into one of what was going on: how sure they were before
  // promising, and — asked only at the check-in — what got in the way or
  // what helped. Keys from the fixed lists, never free text.
  confidence Int? // 1–5, before the promise
  blocker    String? // BLOCKERS key, only on a miss
  helper     String? // HELPERS key, only on a keep

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([era_id, local_day])
  @@index([user_id, local_day])
}

// Someone started an era through another user's "Join this era" link.
// `inviter_era_id` is the era that was shared (its id rides the link as
// ?from=), so a join is credited to the era, not just the person — which is
// what "3 friends are in your Locked In era" will count. One row per invitee
// per shared era: re-joining through the same link doesn't count twice.
model EraReferral {
  id              String   @id @default(cuid())
  inviter_era_id  String
  inviter_user_id String
  invitee_user_id String
  invitee_era_id  String
  era_key         String
  created_at      DateTime @default(now())

  @@unique([invitee_user_id, inviter_era_id])
  @@index([inviter_user_id])
  @@index([inviter_era_id])
}

/// One run of a guided exercise — the practice step of a day.
///
/// A row is written when someone STARTS, and updated when they finish, so
/// the ones people abandon are visible: "which exercises do users quit" is
/// the question that makes this table worth having, and only recording
/// completions would answer it with silence.
///
/// `helped` is deliberately not a mood rating. It asks about the EXERCISE
/// ("did that settle you?"), not about the person's mental state, so it
/// needs no wellness consent and cannot be read as a self-diagnosis — see
/// lib/wellness/scales.ts for why that line matters.
model ExerciseRun {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// The era it was practised in, if any. Kept nullable: an era can end
  /// while its rows stay, and exercises will outlive eras.
  era_id String?

  /// Key from lib/exercises/library.ts. Never renamed, so old rows keep
  /// pointing at something real.
  exercise_id String
  local_day   String // YYYY-MM-DD in the user's timezone

  /// How long it was meant to run, so a shortened exercise is still
  /// comparable later.
  seconds_planned Int
  seconds_done    Int     @default(0)
  completed       Boolean @default(false)

  /// "no" | "some" | "yes" — asked once at the end, optional.
  helped String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// One run per exercise per day: repeating the same practice twice in a
  /// day should update the row, not stack duplicates.
  @@unique([user_id, local_day, exercise_id])
  @@index([user_id, local_day])
  @@index([exercise_id, completed])
}

/// A discipline someone already cares about, which Voxu keeps them
/// consistent with — a gym split, ten pages a day, two hours of deep work.
///
/// Voxu stores the CADENCE and the FLOOR, never the contents: no sets, no
/// reps, no page numbers, no routes. The moment this table holds a workout
/// it is competing with apps built for that, and losing. `minimum` is the
/// mechanism — the smallest version that still counts, set on a calm day to
/// be read on a hard one.
///
/// Capped at three per person in code (lib/practices/presets MAX_PRACTICES):
/// three things to keep in a day is already a lot, and thin data can never
/// support the cross-practice patterns that make this worth having.
model Practice {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// Key from lib/practices/presets.ts, or "custom". Never renamed.
  preset_key String
  /// What they call it. The preset's label until they change it.
  label String
  /// Weekdays it is expected, 0 = Sunday. Empty means every day.
  days Int[] @default([])
  /// The smallest version that still counts, in their own words.
  minimum String

  /// What THEY do on each day of this practice — slot key to their own
  /// lines: { "pull": ["Lat pulldown", "Rows"] } or { "any": ["Rich Dad
  /// Poor Dad"] }. Slots come from the practice (lib/practices/plan.ts):
  /// a named split rotates, anything else gets one slot per scheduled day.
  ///
  /// Free text Voxu stores and shows back on the right day. It is never
  /// parsed, counted, progressed or graded — "Bench 4x8" is a note to
  /// themselves, which is why holding it does not make this a workout
  /// tracker. Voxu writes no programmes: it does not know anyone's
  /// injuries, equipment or experience.
  plan Json?

  /// Why they usually skip it — a BLOCKERS key (lib/era/reasons.ts), reusing
  /// that list rather than inventing a parallel vocabulary, so both can be
  /// counted together.
  blocker String?

  status     String    @default("active") // "active" | "retired"
  retired_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  logs PracticeLog[]

  @@index([user_id, status])
}

/// One day's answer for one practice. `minimum_only` is a kept day, not a
/// half-failure: doing the floor on a bad day is the behaviour the whole
/// feature is trying to produce.
model PracticeLog {
  id          String   @id @default(cuid())
  practice_id String
  practice    Practice @relation(fields: [practice_id], references: [id], onDelete: Cascade)
  user_id     String

  local_day String // YYYY-MM-DD in the user's timezone
  done      Boolean
  /// They did the minimum and no more.
  minimum_only Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([practice_id, local_day])
  @@index([user_id, local_day])
}

/// One visit to Nervous-System mode (lib/reset) — the times someone came to
/// Voxu to come down rather than to be pushed.
///
/// Worth recording for one reason: it is the only signal the app has that
/// the era was the wrong ask that day. The state key is behavioural, so it
/// is always stored.
///
/// The 1-5 before/after numbers are SELF-REPORTED STATE, the same class of
/// data as WellnessCheckIn, so they are only written when
/// UserPreferences.wellness_enabled is on. Without consent the session
/// still counts and the person still sees their own before/after on screen
/// — it simply is not kept.
model ResetSession {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// ResetStateId from lib/reset/states.ts. Never renamed.
  state     String
  local_day String // YYYY-MM-DD in the user's timezone

  /// 1-5 before and after, only with wellness consent.
  before Int?
  after  Int?

  /// They finished the session rather than leaving part-way.
  completed Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, local_day])
  @@index([state])
}
/// Reviewed technique guidance for one movement in lib/movements/library.ts.
///
/// Voxu writes no form cues. This table is the only way they get in, and
/// lib/movements/technique.ts guards the door: a real person's name, a date,
/// and no dose, evidence claim or medical claim. A movement with no row here
/// shows MOVEMENT_TECHNIQUE_PENDING instead — which is the honest state, not
/// a placeholder.
///
/// Not per-user and not user-generated: written by whoever reviews, read by
/// everyone.
model MovementTechnique {
  id String @id @default(cuid())

  /// Movement id from the library. Never renamed, so this stays valid.
  movement_id String @unique

  /// Published rows are the only ones any reader sees. A draft — written by
  /// the model to save a reviewer typing — stays invisible until a person
  /// puts their name on it. The read path filters on this, so there is no
  /// route by which an unsigned draft reaches a screen.
  published Boolean @default(false)

  /// The person standing behind these words. Shown on the screen. Empty
  /// while a draft is waiting for one.
  reviewed_by String
  /// YYYY-MM-DD. The screen shows how old the guidance is.
  reviewed_on String

  /// string[] — the numbered how-to.
  steps Json
  /// { label, detail? }[] — the short cues.
  cues Json?
  /// { label, detail? }[] — what goes wrong, named without blame.
  mistakes Json?
  /// { label, detail?, x, y, side }[] — labels pinned to the hero image.
  callouts Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/// A book somebody is reading, or finished.
///
/// The reading practice already holds a typed title in Practice.plan, and
/// that stays: it is a note to themselves on the right day, and it is never
/// parsed (see the comment on Practice.plan). This model is the other thing —
/// the book RESOLVED against a catalogue, so the app knows it is 323 pages by
/// James Clear and can say something true about it.
///
/// Both exist on purpose. Typing a title must keep working with no lookup, no
/// network and no account of what you read; resolving one is an upgrade you
/// choose.
model Book {
  id      String @id @default(cuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  title  String
  author String?

  /// Total pages from the catalogue. NULL when unknown, and it often is —
  /// half of Open Library's results have no page count. Never estimated:
  /// a made-up total turns every progress line into fiction.
  pages Int?

  cover_url String?

  /// Provider id, e.g. "openlibrary:/works/OL17930368W". Kept so the same
  /// book can be recognised again and re-fetched if the record improves.
  source_id String?

  /// The page they say they are on. Their own number, typed by them.
  current_page    Int?
  current_page_at DateTime?

  /// The previous reading, kept so a pace can be computed from two real
  /// points instead of guessed. Two samples is a rough pace and is
  /// described as one; it is still their own data rather than an average
  /// somebody invented.
  prev_page    Int?
  prev_page_at DateTime?

  /// The era-connected summary, cached so reopening the card costs nothing,
  /// with the era day it was written for — the "for your era" half is about
  /// a specific day, so a stale one should be refreshable.
  summary     Json?
  summary_day Int?

  started_at  DateTime  @default(now())
  finished_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// The shelf query: unfinished first, newest first.
  @@index([user_id, finished_at])
}

/// A routine: the day, as the person arranged it.
///
/// One per user. A day is one thing, and several competing routines would
/// raise "which routine is this in?" — the same trap as two habit systems.
///
/// It REMINDS; it does not record. A discipline asks whether you did it and
/// keeps a run; a routine tells you when. If both recorded, every user would
/// face an arbitrary choice about where to put something.
///
/// Not the `Routine` that was dropped earlier the same day — that was an audio
/// playlist (pick from seven soundscapes, play them back to back) and nothing
/// here resembles it. See docs/routines-scope.md.
model Routine {
  id      String @id @default(cuid())
  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// What they call it. "My morning", "Evenings".
  label String

  /// "timed" | "sequence" — and this is the spine of the whole feature.
  ///
  ///   timed     every step has a clock time; the time IS the order, so
  ///             there is nothing to drag, and each step gets a reminder.
  ///   sequence  they tap Start and Voxu walks them through it in order;
  ///             the order is theirs, so dragging is the only way to set
  ///             it, and there is one reminder for the start rather than
  ///             seven.
  ///
  /// Every argument about drag handles, per-step times and notifications
  /// resolves differently per mode, which is why this is stored rather than
  /// inferred.
  mode String @default("timed")

  /// When a SEQUENCE routine is nudged to begin. Null means no reminder —
  /// they start it when they start it. Meaningless in timed mode, where each
  /// step carries its own time.
  start_time String?

  /// Weekdays it runs, 0 = Sunday. Empty means every day — the same
  /// convention as Practice.days, so the two cannot mean different things.
  days Int[] @default([])

  /// Off without deleting, so the steps and their times survive a pause.
  enabled Boolean @default(true)

  steps RoutineStep[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

/// One moment in a routine: what, and when.
model RoutineStep {
  id         String  @id @default(cuid())
  routine_id String
  routine    Routine @relation(fields: [routine_id], references: [id], onDelete: Cascade)

  /// What this step is — see ROUTINE_STEP_KINDS in lib/routines/steps.ts.
  /// "audio" | "promise" | "exercise" | "practice" | "journal" | "reset" | "own"
  kind String

  /// Which thing, where the kind needs one: a Practice id for "practice".
  /// Null for every kind that has only one target.
  ref String?

  /// Their words. Required for "own", optional elsewhere as a note to
  /// themselves — the app never rewrites it.
  label String?

  /// The smallest version of this step that still counts, in their words:
  /// "5 pages", "20 minutes". Free text, never parsed — same contract as
  /// Practice.minimum, and the thing a Minimum Day is built from.
  ///
  /// Only for a step of their OWN. A step pointing at a discipline borrows
  /// that discipline's minimum, so the floor for reading is written in one
  /// place and cannot drift between the routine and the record.
  minimum String?

  /// HH:MM in their own timezone. The notification fires here, on the device.
  ///
  /// Nullable because a SEQUENCE step has no clock time — it happens when
  /// the one before it is done. Required in timed mode, enforced in
  /// lib/routines/steps.ts rather than by the column, since the same table
  /// holds both kinds of routine.
  time String?

  /// The order in sequence mode, and the tie-break in timed mode.
  ///
  /// In timed mode the clock decides and this only stops two steps at the
  /// same minute swapping places between renders. In sequence mode it is the
  /// whole answer, which is why dragging is worth building there and
  /// meaningless in the other.
  position Int @default(0)

  /// Does this step survive a bad day?
  ///
  /// "Never break the identity. Shrink the routine when needed" — the
  /// strongest idea in Francis's spec. A Minimum Day runs only the steps
  /// marked here, at their own smaller floors.
  ///
  /// Defaults to FALSE, so the minimum is something they choose rather than
  /// something the app assumed. With none chosen, Minimum mode is offered as
  /// unavailable and says why, instead of quietly running an empty day.
  in_minimum Boolean @default(false)

  created_at DateTime @default(now())

  @@index([routine_id])
}
