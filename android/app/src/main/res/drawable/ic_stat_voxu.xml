<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon.

  Android 5+ draws this as a SILHOUETTE: every non-transparent pixel is
  repainted a single colour, and alpha is the only thing that survives. So
  this is white-on-transparent by design — a colour version would come out
  identical, and the launcher icon (@mipmap/ic_launcher) used in its place
  renders as a featureless white square.

  The concentric rings are the Voxu mark reduced to the one shape that still
  reads at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Centre -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,10.5 a1.5,1.5 0 1,0 0.01,0 z" />

    <!--
      Each ring is an outer circle with an inner circle punched out.
      fillType="evenOdd" is what makes the hole; without it the default
      nonZero rule would need the two subpaths wound in opposite directions,
      which works but breaks the moment somebody edits a sweep flag.
      evenOdd needs API 24, and minSdk is 24.
    -->
    <!-- Inner ring -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,7.25 a4.75,4.75 0 1,0 0.01,0 z M12,8.75 a3.25,3.25 0 1,0 0.01,0 z" />

    <!-- Outer ring -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2.75 a9.25,9.25 0 1,0 0.01,0 z M12,4.25 a7.75,7.75 0 1,0 0.01,0 z" />
</vector>
