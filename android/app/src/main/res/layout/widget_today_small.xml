<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_bg" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

        <TextView android:id="@+id/w_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="VOXU" android:textAllCaps="true" android:letterSpacing="0.16" android:textSize="10sp"
            android:fontFamily="sans-serif-medium" android:textColor="#8CFFFFFF" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="26sp" android:fontFamily="serif" android:textColor="#FFFFFFFF" android:maxLines="1"/>
            <TextView android:id="@+id/w_era" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#8CFFFFFF" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <ImageView android:id="@+id/w_ring" android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no"/>
    </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/wg_pill"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/w_left" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:maxLines="1" android:ellipsize="end"/>
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/wg_chevron" android:tint="#8CFFFFFF" android:importantForAccessibility="no"/>
    </LinearLayout>
</LinearLayout>
