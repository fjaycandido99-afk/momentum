<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_bg" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/wg_promise_photo" android:importantForAccessibility="no"/>
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/wg_photo_fade" android:scaleType="fitXY" android:importantForAccessibility="no"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">

        <TextView android:id="@+id/w_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Locked In · Day 13" android:textAllCaps="true" android:letterSpacing="0.16" android:textSize="10sp"
            android:fontFamily="sans-serif-medium" android:textColor="#8CFFFFFF" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Today’s Promise" android:textSize="18sp" android:fontFamily="serif" android:textColor="#FFFFFFFF"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <ImageView android:id="@+id/w_promise_icon" android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/wg_circle" android:tint="#8CFFFFFF" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/w_promise" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF"
                android:maxLines="3" android:ellipsize="end" android:text="Work on my business for 20 minutes."/>
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">

            <LinearLayout android:id="@+id/w_mark" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/wg_pill" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/wg_check" android:importantForAccessibility="no"/>
                <TextView android:id="@+id/w_mark_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:text="Mark Done" android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:maxLines="1"/>
            </LinearLayout>
            <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" android:textSize="11sp" android:textColor="#8CFFFFFF" android:maxLines="1" android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
