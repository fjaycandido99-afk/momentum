<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_bg" android:orientation="vertical" android:padding="14dp">

        <TextView android:id="@+id/w_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="VOXU" android:textAllCaps="true" android:letterSpacing="0.16" android:textSize="10sp"
            android:fontFamily="sans-serif-medium" android:textColor="#8CFFFFFF" android:maxLines="1" android:ellipsize="end"/>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/w_quote" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="“Small steps, repeated, become a life.”" android:textSize="16sp" android:fontFamily="serif"
        android:textColor="#FFFFFFFF" android:maxLines="5" android:ellipsize="end"/>
    <TextView android:id="@+id/w_author" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="— Voxu" android:textSize="10sp" android:textColor="#8CFFFFFF" android:maxLines="1"/>
    <TextView android:id="@+id/w_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="Open Voxu once to connect." android:textSize="9sp" android:textColor="#66FFFFFF" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
